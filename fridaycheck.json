    {
      "parameters": {
        "chatId": "-1001938190303",
        "text": "={{ (function() {\n  try {\n    const input = $(\"Aggregate\").item.json.data;\n    if (!input || !Array.isArray(input)) return \"⚠️ Данные не найдены\";\n\n    const today = new Date().toLocaleDateString('ru-RU', {\n      day: 'numeric', month: 'long'\n    });\n\n    const ready = [];\n    const notReady = [];\n    const noInfo = [];\n\n    for (const item of input) {\n      const sterilRaw = Array.isArray(item['sterilization_date']) \n        ? item['sterilization_date'][0] \n        : item['sterilization_date'];\n\n      const cat = {\n        id: Array.isArray(item['request_id']) ? item['request_id'][0] : (item['request_id'] ?? '—'),\n        room: item['room_cage'] ?? (Array.isArray(item['room']) ? item['room'].join(', ') : '—'),\n        sterilDate: sterilRaw\n          ? new Date(sterilRaw).toLocaleDateString('ru-RU', {day: 'numeric', month: 'long'})\n          : '—',\n        notes: (item['notes_kk'] ?? '').trim(),\n        isReady: item['isReady'] === true || item['isReady'] === 1\n      };\n\n      if (cat.isReady) {\n        ready.push(cat);\n      } else if (cat.notes) {\n        notReady.push(cat);\n      } else {\n        noInfo.push(cat);\n      }\n    }\n\n    const formatCat = (cat) => {\n      let line = `  № ${cat.id} | комната: ${cat.room} | дата стерилки: ${cat.sterilDate}`;\n      if (cat.notes) line += `\\n    💬 комментарий: ${cat.notes}`;\n      return line;\n    };\n\n    let text = `🐱 Список на выписку — ${today}\\n`;\n    text += `Всего кошек: ${input.length}\\n\\n`;\n\n    text += `✅ Готовы к выписке: ${ready.length}\\n`;\n    text += ready.length > 0 ? ready.map(formatCat).join('\\n') + '\\n' : 'нет кошек\\n';\n\n    text += `\\n⏳ Не готовы: ${notReady.length}\\n`;\n    text += notReady.length > 0 ? notReady.map(formatCat).join('\\n') + '\\n' : 'нет кошек\\n';\n\n    text += `\\n❓ Нет инфо: ${noInfo.length}\\n`;\n    text += noInfo.length > 0 ? noInfo.map(formatCat).join('\\n') + '\\n' : 'нет кошек\\n';\n\n    text += `\\n@DieAhnung @astro_lina`;\n\n    return text;\n  } catch(e) {\n    return \"⚠️ Ошибка: \" + e.message;\n  }\n})() }}",
        "additionalFields": {
          "reply_to_message_id": 114445
        }
      },
